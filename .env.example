# =================================================================
# OPTIK I SEE YOU — ENVIRONMENT VARIABLES TEMPLATE
# =================================================================

# ─────────────────────────────────────────────────────────────────
# 1. CLOUDFLARE R2 CREDENTIALS (Media Library & Persistent Store)
# ─────────────────────────────────────────────────────────────────
# Digunakan untuk upload gambar produk, softlens, cover blog,
# serta cloud sync data CMS (frames, softlens, blog, content).
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_cloudflare_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_cloudflare_r2_secret_access_key
R2_BUCKET_NAME=isy-photobooth
R2_PUBLIC_DOMAIN=https://assets.optikiseeyou.com
NEXT_PUBLIC_R2_PUBLIC_DOMAIN=https://assets.optikiseeyou.com

# Bucket khusus proposal sponsor (jika menggunakan modul sponsor)
R2_SPONSOR_BUCKET_NAME=isy-proposals
R2_SPONSOR_PUBLIC_DOMAIN=https://proposals.optikiseeyou.com

# ─────────────────────────────────────────────────────────────────
# 2. SUPABASE POSTGRESQL (Opsional / Recommended untuk Multi-Instance)
# ─────────────────────────────────────────────────────────────────
# Jika diisi, CMS akan langsung menggunakan PostgreSQL Supabase
# dengan migration yang tersedia di supabase/migrations/20261021_initial_schema.sql.
# Jika kosong, CMS otomatis menggunakan storage Cloudflare R2 + fallback file lokal data/store/.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ─────────────────────────────────────────────────────────────────
# 3. INITIAL ADMIN CMS CREDENTIALS
# ─────────────────────────────────────────────────────────────────
# Kredensial akun Owner pertama yang dibuat secara otomatis
# saat aplikasi pertama kali dijalankan.
INITIAL_ADMIN_EMAIL=admin@optikiseeyou.com
INITIAL_ADMIN_PASSWORD=your_secure_admin_password

# PIN khusus untuk akses halaman /admin/sponsor lama
ADMIN_SPONSOR_PIN=2409

# ─────────────────────────────────────────────────────────────────
# 4. CLOUDINARY (Opsional - Fallback upload kamera photobooth)
# ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_upload_preset
